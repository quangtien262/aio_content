# URL của website đã triển khai API, không thêm dấu / ở cuối.
#CONTENT_API_BASE_URL=https://tech.htvietnam.vn

# Tạo trên máy chủ bằng: php artisan content-api:issue-token "Tech Content Publisher"
# Token mới nên có: posts.read, posts.write, posts.publish, media.write,
# translations.read, translations.write, translations.publish.
# Token cũ có posts.* vẫn tương thích với route translation hiện tại.
#CONTENT_API_TOKEN=

# Mặc định xuất bản ngay; đổi thành draft nếu cần quy trình duyệt.
CONTENT_API_DEFAULT_STATUS=published

# Chỉ cần khi PHP local chưa cấu hình curl.cainfo.
#CONTENT_API_CA_BUNDLE=

# chạy lệnh sau trên server để lấy key:
php artisan content-api:issue-token "Tech Content Publisher Production" \
  --website=website-main \
  --source=tech-content \
  --abilities=posts.read,posts.write,posts.publish,media.write


CONTENT_API_BASE_URL=https://tech.htvietnam.vn
CONTENT_API_TOKEN=
CONTENT_API_DEFAULT_STATUS=published
CONTENT_API_CA_BUNDLE=C:\Program Files\Git\mingw64\etc\ssl\certs\ca-bundle.crt
